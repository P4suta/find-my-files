{
  "stryker-config": {
    "project": "FindMyFiles.csproj",
    "test-projects": ["FindMyFiles.Tests.csproj"],
    "concurrency": 4,
    "additional-timeout": 30000,
    "mutate": [
      "**/Services/ShellOps.cs",
      "**/Services/ServiceProvisioner.cs",
      "**/Services/ServiceSetup.cs",
      "**/ViewModels/SearchOrchestrator.cs",
      "**/ViewModels/MainViewModel.cs",
      "**/Engine/EngineClientFactory.cs",
      "**/Engine/EngineErrorSeverityWire.cs",
      "**/Engine/Transport/PipeEngineClient.cs",
      "**/Engine/Transport/PipeConnection.cs",
      "**/Engine/Transport/ResultLeaseGate.cs",
      "**/Engine/PageCodec.cs",
      "**/Engine/PipeProtocol.cs",
      "**/Engine/Wtf8.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "report-file-name": "mutation-report",
    "reporters": ["progress", "json"]
  }
}
