<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="FindMyFiles.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:FindMyFiles.Converters"
    xmlns:ctl="using:FindMyFiles.Controls"
    xmlns:vm="using:FindMyFiles.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Uid="SettingsDialogRoot"
    AutomationProperties.AutomationId="SettingsDialog"
    DefaultButton="Close"
    mc:Ignorable="d">

    <!--  Settings, status and diagnostics — the gear button's surface, rebuilt as a
          Fluent settings page (self-built SettingsCard, no CommunityToolkit dep).
          Toggles two-way bind to the ViewModel (its OnXxxChanged handlers persist +
          requery); sort / regex-scope / language go through code-behind so they hit
          the same VM methods the old menu used. Status is read-only text.  -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MinWidth="{StaticResource DialogMinWidth}" Spacing="{StaticResource SpacingMedium}">

            <!--  ── Search behaviour ──  -->
            <TextBlock x:Uid="SettingsGroup_Search" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <ctl:SettingsCard
                x:Name="OptFocusedCard"
                Glyph="&#xE71C;"
                Style="{StaticResource SettingsCardStyle}">
                <ToggleSwitch
                    x:Name="OptFocusedToggle"
                    AutomationProperties.AutomationId="OptFocused"
                    IsOn="{x:Bind VM.FocusedSearch, Mode=TwoWay}" />
            </ctl:SettingsCard>
            <ctl:SettingsCard
                x:Name="OptSystemCard"
                Glyph="&#xE890;"
                Style="{StaticResource SettingsCardStyle}">
                <ToggleSwitch
                    x:Name="OptSystemToggle"
                    AutomationProperties.AutomationId="OptSystem"
                    IsOn="{x:Bind VM.IncludeHiddenSystem, Mode=TwoWay}" />
            </ctl:SettingsCard>
            <ctl:SettingsCard
                x:Name="OptRegexCard"
                Glyph="&#xE943;"
                Style="{StaticResource SettingsCardStyle}">
                <ToggleSwitch
                    x:Name="OptRegexToggle"
                    AutomationProperties.AutomationId="OptRegex"
                    IsOn="{x:Bind VM.RegexMode, Mode=TwoWay}" />
            </ctl:SettingsCard>
            <ctl:SettingsCard x:Name="RegexScopeCard" Style="{StaticResource SettingsCardStyle}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmall}">
                    <RadioButton
                        x:Name="RegexScopeName"
                        x:Uid="RegexScopeName"
                        AutomationProperties.AutomationId="RegexScopeName"
                        Click="RegexScopeName_Click"
                        GroupName="RegexScope" />
                    <RadioButton
                        x:Name="RegexScopePath"
                        x:Uid="RegexScopePath"
                        AutomationProperties.AutomationId="RegexScopePath"
                        Click="RegexScopePath_Click"
                        GroupName="RegexScope" />
                </StackPanel>
            </ctl:SettingsCard>

            <!--  ── Sorting ──  -->
            <ctl:SettingsCard
                x:Name="SortFieldCard"
                Glyph="&#xE8CB;"
                Style="{StaticResource SettingsCardStyle}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmall}">
                    <RadioButton
                        x:Name="SortName"
                        x:Uid="SortName"
                        AutomationProperties.AutomationId="SortName"
                        Click="SortName_Click"
                        GroupName="SortField" />
                    <RadioButton
                        x:Name="SortSize"
                        x:Uid="SortSize"
                        AutomationProperties.AutomationId="SortSize"
                        Click="SortSize_Click"
                        GroupName="SortField" />
                    <RadioButton
                        x:Name="SortDate"
                        x:Uid="SortDate"
                        AutomationProperties.AutomationId="SortDate"
                        Click="SortDate_Click"
                        GroupName="SortField" />
                </StackPanel>
            </ctl:SettingsCard>
            <ctl:SettingsCard x:Name="SortDescendingCard" Style="{StaticResource SettingsCardStyle}">
                <ToggleSwitch
                    x:Name="SortDescendingToggle"
                    AutomationProperties.AutomationId="SortDescending"
                    IsOn="{x:Bind VM.SortDescending, Mode=OneWay}"
                    Toggled="SortDescending_Toggled" />
            </ctl:SettingsCard>

            <!--  ── General ──  -->
            <TextBlock x:Uid="SettingsGroup_General" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <ctl:SettingsCard
                x:Name="LanguageCard"
                Glyph="&#xE774;"
                Style="{StaticResource SettingsCardStyle}">
                <ComboBox
                    x:Name="LangCombo"
                    AutomationProperties.AutomationId="LangCombo"
                    SelectionChanged="Language_SelectionChanged">
                    <ComboBoxItem
                        x:Name="LangAuto"
                        x:Uid="LangSystem"
                        AutomationProperties.AutomationId="LangSystem"
                        Tag="auto" />
                    <ComboBoxItem
                        x:Name="LangJa"
                        AutomationProperties.AutomationId="LangJa"
                        Content="日本語"
                        Tag="ja" />
                    <ComboBoxItem
                        x:Name="LangEn"
                        AutomationProperties.AutomationId="LangEn"
                        Content="English"
                        Tag="en" />
                    <ComboBoxItem
                        x:Name="LangZh"
                        AutomationProperties.AutomationId="LangZh"
                        Content="简体中文"
                        Tag="zh-Hans" />
                </ComboBox>
            </ctl:SettingsCard>
            <ctl:SettingsCard
                x:Name="CloseToTrayCard"
                Glyph="&#xE922;"
                Style="{StaticResource SettingsCardStyle}">
                <ToggleSwitch
                    x:Name="CloseToTrayToggle"
                    AutomationProperties.AutomationId="OptCloseToTray"
                    IsOn="{x:Bind VM.CloseToTray, Mode=TwoWay}" />
            </ctl:SettingsCard>

            <!--  ── Status (read-only) ──  -->
            <TextBlock x:Uid="StatusMenuItem" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <StackPanel Spacing="{StaticResource SpacingXSmall}">
                <TextBlock
                    AutomationProperties.AutomationId="StatusMode"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind VM.ModeText, Mode=OneTime}"
                    Visibility="{x:Bind conv:UiConverters.BoolToVis(VM.IsReady), Mode=OneWay}" />
                <TextBlock
                    AutomationProperties.AutomationId="StatusState"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind VM.StatusText, Mode=OneWay}" />
                <TextBlock
                    AutomationProperties.AutomationId="StatusCount"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind VM.Results.CountText, Mode=OneWay}"
                    Visibility="{x:Bind conv:UiConverters.VisibleIfNotEmpty(VM.Results.CountText), Mode=OneWay}" />
                <!--  Build identity: the app version (always) and the engine/service
                      version (pipe mode only). Selectable so it can be copied into a
                      bug report; a base mismatch raises the warning below.  -->
                <TextBlock
                    AutomationProperties.AutomationId="AboutAppVersion"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsTextSelectionEnabled="True"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind vm:MainViewModel.AppVersionText, Mode=OneTime}" />
                <TextBlock
                    AutomationProperties.AutomationId="AboutEngineVersion"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsTextSelectionEnabled="True"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind VM.EngineVersionText, Mode=OneWay}"
                    Visibility="{x:Bind conv:UiConverters.BoolToVis(VM.HasEngineVersion), Mode=OneWay}" />
                <InfoBar
                    x:Uid="AboutVersionMismatch"
                    AutomationProperties.AutomationId="AboutVersionMismatch"
                    IsClosable="False"
                    IsOpen="{x:Bind VM.HasVersionMismatch, Mode=OneWay}"
                    Severity="Warning" />
            </StackPanel>

            <!--  ── Advanced & management ──  -->
            <TextBlock x:Uid="SettingsGroup_Advanced" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <ctl:SettingsCard
                x:Name="DiagnosticsCard"
                Glyph="&#xE9D9;"
                Style="{StaticResource SettingsCardStyle}">
                <Button
                    x:Uid="DiagOpen"
                    AutomationProperties.AutomationId="DiagToggle"
                    Click="Diag_Click" />
            </ctl:SettingsCard>
            <ctl:SettingsCard
                x:Name="ServiceCard"
                Glyph="&#xE912;"
                Style="{StaticResource SettingsCardStyle}">
                <Button
                    x:Uid="ServiceOpen"
                    AutomationProperties.AutomationId="ServiceManageMenu"
                    Click="Service_Click" />
            </ctl:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
