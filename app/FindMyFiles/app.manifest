<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="FindMyFiles.app"/>

  <!-- Privileged work (MFT/USN reads) lives in the fmf-engine service; the
       UI runs unprivileged. In-proc mode (-engine=inproc) is the exception:
       start it manually from an administrator terminal (asInvoker does not
       block launching from an elevated shell). NOTE: mt.exe cannot parse
       non-ASCII text in this file - keep this comment ASCII. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <!-- The engine indexes paths up to 32767 UTF-16 units, so the UI must be
           able to act on them. This file REPLACES the .NET apphost manifest
           (csproj <ApplicationManifest>), which carries longPathAware=true;
           without re-declaring it here the raw CreateFileW that pins a result
           before "open"/"reveal" fails with ERROR_PATH_NOT_FOUND past
           MAX_PATH. Effective only when the machine policy
           HKLM\SYSTEM\CurrentControlSet\Control\FileSystem\LongPathsEnabled
           is 1 - both halves are required. -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
