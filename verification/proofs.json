{
  "schema_version": 1,
  "kani_version": "0.68.0",
  "jobs": 2,
  "timeout_seconds": 90,
  "targets": [
    {
      "package": "xtask",
      "source": "xtask/src/mutation_authority_proofs.rs",
      "prefix": "mutation_authority::kani_proofs::",
      "harnesses": [
        "candidate_audits_never_authorize_protected_main_execution"
      ]
    },
    {
      "package": "xtask",
      "source": "xtask/src/overflow_proofs.rs",
      "prefix": "perf::overflow::kani_proofs::",
      "harnesses": [
        "a_measurement_boot_follows_preparation_and_is_not_in_the_future",
        "every_round_contains_each_variant_in_the_required_order",
        "profile_arguments_change_only_the_selected_overflow_checks"
      ]
    },
    {
      "package": "xtask",
      "source": "xtask/src/sbom/managed_proofs.rs",
      "prefix": "sbom::managed::kani_proofs::",
      "harnesses": [
        "accepted_table_ranges_are_contained_without_arithmetic_overflow",
        "accepted_compressed_integers_consume_exactly_the_canonical_prefix"
      ]
    },
    {
      "package": "xtask",
      "source": "xtask/src/semver_proofs.rs",
      "prefix": "semver::kani_proofs::",
      "harnesses": [
        "product_base_ends_at_the_first_metadata_delimiter"
      ]
    },
    {
      "package": "xtask",
      "source": "xtask/src/mutation_proofs.rs",
      "prefix": "mutation::kani_proofs::",
      "harnesses": [
        "test_slots_fit_every_nonzero_cpu_budget_without_overflow",
        "activation_requires_executed_kills_and_no_unresolved_outcomes"
      ]
    },
    {
      "package": "fmf-core",
      "source": "engine/crates/fmf-core/src/recovery_proofs.rs",
      "prefix": "recovery::kani_proofs::",
      "harnesses": [
        "failures_never_rearm_and_panics_never_back_off",
        "backoff_consumes_the_only_automatic_allowance",
        "explicit_requests_rearm_only_failed_workers",
        "automatic_backoff_is_exact_for_every_elapsed_duration"
      ]
    },
    {
      "package": "fmf-core",
      "source": "engine/crates/fmf-core/src/histogram_proofs.rs",
      "prefix": "histogram::kani_proofs::",
      "harnesses": [
        "slots_are_always_bounded_and_preserve_every_valid_index",
        "samples_have_a_bounded_bucket_and_a_conservative_upper_bound"
      ]
    },
    {
      "package": "fmf-runtime",
      "source": "engine/crates/fmf-runtime/src/metrics_proofs.rs",
      "prefix": "metrics::kani_proofs::",
      "harnesses": [
        "recording_changes_only_the_selected_bucket_without_overflow"
      ]
    },
    {
      "package": "fmf-core",
      "source": "engine/crates/fmf-core/src/wtf8_proofs.rs",
      "prefix": "wtf8::kani_proofs::",
      "harnesses": [
        "accepted_points_consume_input_and_use_the_canonical_width",
        "surrogate_pairs_encode_exactly_one_supplementary_scalar",
        "empty_and_single_byte_decoding_preserve_prefix_or_roll_back",
        "output_lengths_preserve_the_prefix_or_reject_overflow",
        "two_byte_width_partitions_cover_every_input",
        "two_byte_ascii_pair_preserves_prefix_or_rolls_back",
        "two_byte_single_two_byte_point_preserves_prefix_or_rolls_back",
        "two_byte_invalid_widths_preserve_output",
        "three_byte_width_partitions_cover_every_input",
        "three_byte_ascii_triple_preserves_prefix_or_rolls_back",
        "three_byte_ascii_then_two_byte_preserves_prefix_or_rolls_back",
        "three_byte_two_byte_then_ascii_preserves_prefix_or_rolls_back",
        "three_byte_single_three_byte_point_preserves_prefix_or_rolls_back",
        "three_byte_invalid_widths_preserve_output",
        "four_byte_width_partitions_cover_every_input",
        "four_byte_ascii_quad_preserves_prefix_or_rolls_back",
        "four_byte_two_ascii_then_two_byte_preserves_prefix_or_rolls_back",
        "four_byte_ascii_two_byte_ascii_preserves_prefix_or_rolls_back",
        "four_byte_two_byte_then_two_ascii_preserves_prefix_or_rolls_back",
        "four_byte_two_two_byte_points_preserves_prefix_or_rolls_back",
        "four_byte_ascii_then_three_byte_preserves_prefix_or_rolls_back",
        "four_byte_three_byte_then_ascii_preserves_prefix_or_rolls_back",
        "four_byte_single_four_byte_point_preserves_prefix_or_rolls_back",
        "four_byte_invalid_widths_preserve_output"
      ]
    },
    {
      "package": "fmf-runtime",
      "source": "engine/crates/fmf-runtime/src/index/snapshot_proofs.rs",
      "prefix": "index::snapshot::kani_proofs::",
      "harnesses": [
        "byte_columns_are_initialized_before_reader_access",
        "word_columns_are_initialized_before_reader_access",
        "wide_columns_are_initialized_before_reader_access",
        "initialized_growth_preserves_arbitrary_existing_column_bytes"
      ]
    },
    {
      "package": "xtask",
      "source": "xtask/src/proof_proofs.rs",
      "prefix": "proof::kani_proofs::",
      "harnesses": [
        "accepted_summary_requires_every_registered_harness_to_pass",
        "a_complete_nonempty_summary_remains_acceptable"
      ]
    },
    {
      "package": "fmf-contract",
      "source": "engine/crates/fmf-contract/src/kani_proofs.rs",
      "prefix": "kani_proofs::",
      "harnesses": [
        "frame_header_fields_roundtrip",
        "frame_header_bytes_roundtrip",
        "frame_header_matches_little_endian_layout",
        "encoded_bytes_preserve_prefix_and_zero_padding",
        "encoded_labels_always_terminate",
        "label_prefix_stops_at_first_zero"
      ]
    },
    {
      "package": "fmf-core",
      "source": "engine/crates/fmf-core/src/ondisk/fixup_proofs.rs",
      "prefix": "ondisk::fixup::kani_proofs::",
      "harnesses": [
        "byte_layout_decodes_independent_little_endian_fields",
        "accepted_layout_bounds_every_sector_and_update_sequence_word",
        "invalid_sector_geometry_never_produces_a_layout"
      ]
    },
    {
      "package": "fmf-core",
      "source": "engine/crates/fmf-core/src/ondisk/ntfs_proofs.rs",
      "prefix": "ondisk::ntfs::kani_proofs::",
      "harnesses": [
        "shared_file_geometry_preserves_header_admission",
        "reference_bytes_preserve_record_and_sequence_fields",
        "accepted_name_values_have_bounded_units_namespaces_and_parent_references",
        "attribute_traversal_consumes_bounded_positive_lengths",
        "accepted_boot_geometry_contains_a_complete_record_without_overflow",
        "every_short_boot_sector_is_rejected_before_field_access",
        "accepted_attribute_ranges_remain_inside_the_declared_buffer"
      ]
    },
    {
      "package": "fmf-core",
      "source": "engine/crates/fmf-core/src/ondisk/record_proofs.rs",
      "prefix": "ondisk::record::kani_proofs::",
      "harnesses": [
        "chains_at_offset_forty_eight_preserve_admission_and_invariants",
        "chains_at_offset_fifty_six_preserve_admission_and_invariants",
        "chains_at_offset_sixty_four_preserve_admission_and_invariants",
        "chains_at_offset_seventy_two_preserve_admission_and_invariants",
        "chains_at_offset_eighty_preserve_admission_and_invariants",
        "chains_at_offset_eighty_eight_preserve_admission_and_invariants",
        "chains_at_offset_ninety_six_preserve_admission_and_invariants",
        "terminal_only_offsets_preserve_admission",
        "remaining_attribute_offsets_reject_the_chain"
      ]
    },
    {
      "package": "fmf-runtime",
      "source": "engine/crates/fmf-runtime/src/index/mutation_proofs.rs",
      "prefix": "index::mutate::kani_proofs::",
      "harnesses": [
        "flag_updates_preserve_unselected_bits_and_are_idempotent",
        "exclusion_uses_only_the_hidden_and_system_bits",
        "file_link_kind_checks_preserve_the_requested_object",
        "metadata_projection_preserves_every_object_field",
        "each_walk_state_has_one_exhaustive_entry_transition"
      ]
    }
  ]
}
